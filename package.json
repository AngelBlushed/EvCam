{
  "name": "evcam",
  "productName": "EvCam",
  "version": "1.4.3",
  "description": "Utilisez la caméra et le micro de votre téléphone sur votre PC.",
  "main": "src/main/main.js",
  "author": "EvCam",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/build-icons.js",
    "vcam": "powershell -NoProfile -ExecutionPolicy Bypass -File native/vcam/build.ps1 -Arch x64 && powershell -NoProfile -ExecutionPolicy Bypass -File native/vcam/build.ps1 -Arch x86",
    "apk": "powershell -NoProfile -ExecutionPolicy Bypass -File android/build.ps1",
    "dist": "npm run apk && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "koffi": "^3.3.3",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "jsqr": "^1.4.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "koffi@3.3.3": true
  }
}
